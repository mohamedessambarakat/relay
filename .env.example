# Port Relay listens on (localhost only).
RELAY_PORT=8000
# ntfy topic for Review/Blocked pushes. Use a long random name; anyone who knows it can read the pushes.
NTFY_TOPIC=
# ntfy server, if you self-host.
NTFY_SERVER=https://ntfy.sh
# Path to the Claude CLI. Leave empty to use ~/.local/bin/claude.exe, then "claude" from PATH.
CLAUDE_BIN=
